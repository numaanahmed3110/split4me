POSTGRES_PRISMA_URL=postgresql://postgres:1234@localhost
POSTGRES_URL_NON_POOLING=postgresql://postgres:1234@localhost

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=EUR

# --- Clerk Auth (email/password + Google in Clerk Dashboard) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- NVIDIA Nemotron (receipt OCR, voice parsing, AI insights) ---
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Deepgram (voice expense — record then upload) ---
# DEEPGRAM_API_KEY=

# --- OneSignal web push (add after Vercel deploy + site URL) ---
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=
# NEXT_PUBLIC_ONESIGNAL_APP_ID=
# Safari-only; OneSignal issues it with the app id.
# NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=

# Opt-in features — uncomment to enable. See the README for what each needs.

# Attach images to expenses (requires S3 storage):
# ENABLE_EXPENSE_DOCUMENTS=true
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=
# S3_UPLOAD_ENDPOINT=       # only needed for non-AWS S3 providers

# Create expenses by scanning receipts (uses Nemotron when NVIDIA_API_KEY is set):
# ENABLE_RECEIPT_EXTRACT=true

# Auto-suggest the expense category from its title (uses Nemotron when NVIDIA_API_KEY is set):
# ENABLE_CATEGORY_EXTRACT=true


# Analytics is disabled unless a provider is selected. See the README.
# ANALYTICS_PROVIDER=console
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_DOMAIN=your-domain.com
